{
  "name": "reachinbox-email-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend service for ReachInbox Email Scheduler application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && rimraf dist && tsc",
    "start": "npx prisma db push --skip-generate && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:studio": "prisma studio",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "reachinbox",
    "email-scheduler",
    "express",
    "typescript",
    "bullmq",
    "redis",
    "prisma",
    "elasticsearch",
    "nodemailer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "@elastic/elasticsearch": "^8.12.2",
    "@prisma/client": "^5.10.2",
    "bullmq": "^5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.28",
    "@types/nodemailer": "^6.4.14",
    "prisma": "^5.10.2",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
