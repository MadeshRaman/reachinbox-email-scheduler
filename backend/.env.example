# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=reachinbox-scheduler-super-secret-jwt-key-2025

# Database (MySQL via Prisma)
DATABASE_URL="mysql://reachinbox_user:reachinbox_password@localhost:3307/reachinbox_email_scheduler"

# Redis (BullMQ & Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Worker Configuration
WORKER_CONCURRENCY=5

# Distributed Rate Limiting & Throttling
MAX_EMAILS_PER_HOUR_PER_SENDER=100
EMAIL_DELAY_MS=500

# Elasticsearch Configuration (Full-text Search & Logs)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# SMTP / Ethereal Email Credentials
# If ETHEREAL_USER & ETHEREAL_PASS are left empty, Nodemailer will auto-generate an ethereal test account on startup!
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=reachinbox@demo.ethereal.email
SMTP_FROM_NAME="ReachInbox Scheduler"

# Slack OAuth Integration Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_FRONTEND_REDIRECT_URI=http://localhost:5173/dashboard?slack=connected

# Google OAuth Integration Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:5173/?token=
