# ==============================================================================
# ReachInbox Email Scheduler - Backend Configuration
# ==============================================================================
# NOTE: In Railway or cloud deployments, enter KEY and VALUE separately.
# Do NOT enter "KEY=VALUE" inside the Railway value input.

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=5000
# For local development: NODE_ENV=development
# For Railway production: NODE_ENV=production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. CORS & Frontend URL
# ------------------------------------------------------------------------------
# Local dev: http://localhost:5173
# Railway Production: https://YOUR-FRONTEND-DOMAIN.up.railway.app
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Security
# ------------------------------------------------------------------------------
JWT_SECRET=reachinbox-scheduler-super-secret-jwt-key-2025

# ------------------------------------------------------------------------------
# 4. Database (MySQL via Prisma)
# ------------------------------------------------------------------------------
# Local dev: mysql://reachinbox_user:reachinbox_password@localhost:3307/reachinbox_email_scheduler
# Railway Production: ${{MySQL.MYSQL_URL}} or ${{DATABASE_URL}}
DATABASE_URL=mysql://reachinbox_user:reachinbox_password@localhost:3307/reachinbox_email_scheduler

# ------------------------------------------------------------------------------
# 5. Redis (BullMQ & Rate Limiter)
# ------------------------------------------------------------------------------
# Railway Production (Automatically prioritized when set):
# REDIS_URL=${{Redis.REDIS_URL}}
# Local development:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Google OAuth Integration Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local dev callback: http://localhost:5000/api/auth/google/callback
# Railway Production callback: https://YOUR-BACKEND-DOMAIN.up.railway.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 7. BullMQ Worker Configuration
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 8. Distributed Rate Limiting & Throttling
# ------------------------------------------------------------------------------
MAX_EMAILS_PER_HOUR_PER_SENDER=100
EMAIL_DELAY_MS=500

# ------------------------------------------------------------------------------
# 9. Elasticsearch Configuration (Full-text Search & Logs)
# ------------------------------------------------------------------------------
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ------------------------------------------------------------------------------
# 10. Standard SMTP Provider Credentials (Required for Production Email Delivery)
# ------------------------------------------------------------------------------
# In Railway production, enter these exact separate environment variables:
# Examples:
#   Gmail:        SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_SECURE=false | SMTP_USER=you@gmail.com | SMTP_PASS=your-16-char-app-password
#   SendGrid:     SMTP_HOST=smtp.sendgrid.net | SMTP_PORT=587 | SMTP_SECURE=false | SMTP_USER=apikey | SMTP_PASS=your-api-key
#   Mailgun:      SMTP_HOST=smtp.mailgun.org | SMTP_PORT=587 | SMTP_SECURE=false | SMTP_USER=postmaster@... | SMTP_PASS=...
#   Brevo/Sendin: SMTP_HOST=smtp-relay.brevo.com | SMTP_PORT=587 | SMTP_SECURE=false | SMTP_USER=... | SMTP_PASS=...
#   Resend:       SMTP_HOST=smtp.resend.com | SMTP_PORT=465 | SMTP_SECURE=true | SMTP_USER=resend | SMTP_PASS=re_...
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME="ReachInbox Scheduler"

# ------------------------------------------------------------------------------
# 11. Slack OAuth Integration Credentials (Optional)
# ------------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_FRONTEND_REDIRECT_URI=http://localhost:5173/dashboard?slack=connected

